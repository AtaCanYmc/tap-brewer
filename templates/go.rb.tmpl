class {{CLASS_NAME}} < Formula
  desc "{{DESC}}"
  homepage "{{HOMEPAGE}}"
  url "{{TARBALL_URL}}"
  sha256 "{{SHA256}}"
  license "{{LICENSE}}"

  depends_on "go" => :build

