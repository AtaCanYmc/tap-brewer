# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicit shell script normalization across Windows, macOS, and Linux
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Documentation and structured data
*.md text diff=markdown
*.rb text
*.tmpl text
*.py text
*.json text
*.yml text
*.yaml text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary

# Release archive exclusions
.github export-ignore
.gitignore export-ignore
.gitattributes export-ignore
.editorconfig export-ignore
.markdownlint.json export-ignore
tests export-ignore
